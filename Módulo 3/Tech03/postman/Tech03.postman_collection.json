            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/graphql",
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "{history(patientId:\"pac-001\"){id startsAt reason clinicalNotes version}}",
            "variables": "{}"
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"GraphQL sem erros\", () => pm.expect(body.errors).to.be.undefined);"
            ]
          }
        }
      ]
    },
