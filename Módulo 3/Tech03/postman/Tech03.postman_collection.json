{
  "info": {
    "name": "Tech03 - Hospital (demo)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "doctorUser",
      "value": "medico",
      "type": "string"
    },
    {
      "key": "doctorPassword",
      "value": "medico1234",
      "type": "string"
    },
    {
      "key": "nurseUser",
      "value": "enfermeiro",
      "type": "string"
    },
    {
      "key": "nursePassword",
      "value": "enfermeiro1234",
      "type": "string"
    },
    {
      "key": "patientUser",
      "value": "paciente",
      "type": "string"
    },
    {
      "key": "patientPassword",
      "value": "paciente1234",
      "type": "string"
    },
    {
      "key": "appointmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "version",
      "value": "1",
      "type": "string"
    },
    {
      "key": "startsAt",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Enfermeiro cria consulta",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{nurseUser}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{nursePassword}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/graphql",
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "mutation($input:AppointmentInput!){createAppointment(input:$input){id version startsAt}}",
            "variables": "{\"input\": {\"patientId\": \"pac-001\", \"doctorId\": \"doc-001\", \"startsAt\": \"{{startsAt}}\", \"durationMinutes\": 30, \"reason\": \"Consulta de demonstracao\"}}"
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"startsAt\", new Date(Date.now() + 48 * 60 * 60 * 1000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"GraphQL sem erros\", () => pm.expect(body.errors).to.be.undefined);",
              "if (body.data?.createAppointment) { pm.collectionVariables.set(\"appointmentId\", body.data.createAppointment.id); pm.collectionVariables.set(\"version\", body.data.createAppointment.version); }"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Paciente ve suas consultas",
      "request": {
        "method": "POST",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{patientUser}}",
